# Demo backend. Default: our Hugging Face Space (Gradio API). Set VITE_GRADIO_SPACE= (empty) and
# VITE_API_BASE to use a REST server with the /jobs contract instead; both empty = mock mode.
VITE_GRADIO_SPACE=Roicaluste/wiut-traffic-events
VITE_API_BASE=
# Upload limits shown to visitors; the Space accepts up to 3 GB and 150 s.
VITE_MAX_UPLOAD_MB=3000
VITE_MAX_DURATION_SEC=150
